# Agent Swarm worker image for Apple Container & AX
# Includes Python, git, ca-certificates, PyYAML, and the google-genai SDK.
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir google-genai pyyaml

COPY agent.py /usr/local/bin/agent.py
RUN chmod +x /usr/local/bin/agent.py

WORKDIR /workspace
