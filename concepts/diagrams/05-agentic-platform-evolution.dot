// AX evolution: from task orchestrator over Agent Substrate 1.0
// to a 7-pillar agentic platform (google/ax#724, docs/roadmap.md).
digraph ax_platform_evolution {
  label = "AX · from task orchestrator to agentic platform (#724)";
  ranksep = 0.85;
  nodesep = 0.45;

  subgraph cluster_platform {
    label = "3. External orchestrator & agentic platform (#724 · #732 · #756)";
    class = "accent";

    // Row 1: continuity & control
    sessions  [label="1. Session management\n(sessionId, turn history)", class="primary code"];
    memory    [label="2. Memory\n(cross-task long-term store)", class="cat-teal"];
    steering  [label="4. Input steering & outcomes\n(orchestrator, TaskService)", class="emphasis code"];
    multitask [label="3. Multi-task coordination\n(ForkTask, A2A, swarms)", class="primary"];

    // Row 2: governance, models & observability
    models       [label="6. Models\n(Model resource, multi-model #709)", class="code"];
    registries   [label="5. Registries\n(MCP, skills, runner images)", class="code"];
    trajectories [label="7. Trajectory collection\n(OTel, prompt & tool traces)", class="positive"];

    // Keep the 7 pillars in a crisp 4-over-3 grid inside the platform cluster.
    memory -> sessions [label="recall", class="async", constraint=false];
    sessions  -> models       [style=invis];
    steering  -> registries   [style=invis];
    multitask -> trajectories [style=invis];
  }

  subgraph cluster_core {
    label = "2. AX control plane (pure declarative · zero data-plane polling · #756/#757)";
    class = "accent";
    task      [label="Task + TaskManager\n(1 Task = 1 Actor · --router-url)", class="emphasis code"];
    workspace [label="Workspace\n(git, skills, MCP)", class="code"];
    gateway   [label="Gateway\n(egress + secrets)", class="code"];
  }

  subgraph cluster_sub {
    label = "1. Agent Substrate 1.0 (compute runtime · future #483 self-suspend)";
    actors     [label="Actor + Tag snapshots\n(1B scale-to-zero)", class="store"];
    workerpool [label="WorkerPool + ActorTemplate\n(<100ms sandbox restore)", class="muted"];
    netedge    [label="atenet-router + atenet-egress\n(inbound h2c, secret injection)", class="muted code"];
  }

  // Platform -> Core
  sessions     -> task      [label="turns"];
  steering     -> task      [label="Send / Watch", class="primary"];
  multitask    -> task      [label="ForkTask", class="primary"];
  models       -> task      [label="providers"];
  models       -> gateway   [label="keys", class="positive"];
  registries   -> workspace [label="MCP & skills"];
  trajectories -> task      [label="telemetry", class="positive"];

  // Core -> Substrate
  task      -> actors     [label="Create / Resume / Tag", class="primary code"];
  workspace -> workerpool [label="hydrate $AX_WORKSPACE"];
  gateway   -> netedge    [label="EgressPolicy"];
}
